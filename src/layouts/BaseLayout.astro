---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  getLocale,
  localizePath,
  stripLocale,
} from '../i18n';
import layoutDict from '../i18n/dict/layout';
import '../style.css';

type Props = {
  title: string;
  description?: string;
  /** Locale-less path of this page (e.g. "/about"). The locale prefix is added here. */
  path?: string;
  ogImage?: string;
  // frame={false} renders the slot without Header/Footer/white background,
  // for standalone pages that bring their own chrome (e.g. /artworks).
  frame?: boolean;
};

const ORIGIN = 'https://tatsuki.dev';

const locale = getLocale(Astro);
const t = layoutDict[locale];
const meta = LOCALE_META[locale];

const {
  title,
  description = t.defaultDescription,
  path = Astro.url.pathname,
  ogImage = `${ORIGIN}/images/main.jpg`,
  frame = true,
} = Astro.props;

// Accept either a locale-less path or an already-prefixed one.
const basePath = stripLocale(path).path;
const fullTitle = `${title} | ${t.siteName}`;
const canonical = `${ORIGIN}${localizePath(basePath, locale)}`;
const alternates = LOCALES.map((l) => ({
  hreflang: LOCALE_META[l].hreflang,
  href: `${ORIGIN}${localizePath(basePath, l)}`,
}));
const xDefault = `${ORIGIN}${localizePath(basePath, DEFAULT_LOCALE)}`;
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={t.author} />
    <meta name="keywords" content={t.keywords} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tatsuki.dev" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: t.person.name,
      alternateName: ['Tatsuki Kitamura', '北村健紀', 'きたむらたつき', 'Kitamura Tatsuki'],
      url: 'https://tatsuki.dev/',
      image: 'https://tatsuki.dev/images/main.jpg',
      jobTitle: t.person.jobTitle,
      description: t.person.description,
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: t.person.university,
        sameAs: 'https://www.waseda.jp/',
      },
      knowsAbout: [
        'Ruby on Rails',
        'React',
        'SwiftUI',
        'Python',
        'C++',
        'FastAPI',
        'PostgreSQL',
        t.person.competitiveProgramming,
      ],
      sameAs: [
        'https://github.com/tatsukikitamura',
        'https://atcoder.jp/users/oreccchi',
      ],
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'tatsuki.dev',
      url: 'https://tatsuki.dev/',
      inLanguage: meta.htmlLang,
      author: { '@type': 'Person', name: t.person.name },
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-MWZJZWMLW8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-MWZJZWMLW8');
    </script>
  </head>
  <body>
    {
      frame ? (
        <div class="min-h-screen flex flex-col bg-white">
          <Header />
          <main class="flex-1">
            <slot />
          </main>
          <Footer />
        </div>
      ) : (
        <slot />
      )
    }
  </body>
</html>
