---
import { getLocale, localizePath } from '../i18n';
import common from '../i18n/dict/common';

const locale = getLocale(Astro);
const t = common[locale];
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-gray-200 py-12 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <p class="text-gray-500 text-sm">© {year} Tatsuki Kitamura. {t.footer.rights}</p>
    <div class="flex items-center gap-6">
      <a
        href="https://github.com/tatsukikitamura"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-500 hover:text-[#0a66c2] transition-colors text-sm"
      >
        GitHub
      </a>
      <a
        href="https://atcoder.jp/users/oreccchi"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-500 hover:text-[#0a66c2] transition-colors text-sm"
      >
        AtCoder
      </a>
      <a
        href={localizePath('/contact', locale)}
        class="text-gray-500 hover:text-[#0a66c2] transition-colors text-sm"
      >
        {t.footer.request}
      </a>
    </div>
  </div>
</footer>
