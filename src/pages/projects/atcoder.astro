---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../components/ProjectBackLink.astro';
import { getTechIcon } from '../../lib/techIcons';

const LANGS = ['Python', 'C++'];

const DESCRIPTION =
  '北村健紀の AtCoder 取り組み。Algorithm 茶 / Heuristic 青（最高レート1603）。約2年継続中、AHC78位・黄色パフォーマンス記録。';
---

<BaseLayout title="AtCoder - 競技プログラミング" description={DESCRIPTION} path="/projects/atcoder">
  <main class="mx-auto max-w-4xl px-4 pt-20 pb-8">
    <ProjectBackLink />

    <div class="animate-fade-in-up mb-12 opacity-0">
      <a
        href="https://atcoder.jp/users/oreccchi"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-block"
      >
        <h1
          class="text-3xl font-bold tracking-tight decoration-2 underline-offset-4 group-hover:underline md:text-4xl"
        >
          AtCoder
        </h1>
      </a>
      <p class="mt-2 text-gray-500">2024年4月〜2026年1月（継続中）</p>
    </div>

    <section
      class="animate-fade-in-up animation-delay-100 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">概要</h2>
      <p class="leading-relaxed text-gray-600">
        AtCoderは、プログラミングの問題を解くスピードと正確性を競うコンテスト。アルゴリズムやデータ構造の知識を活かして、制限時間内に問題を解く形式。継続的に取り組み、Algorithm部門で茶色、Heuristic部門で青色ランク（最高レート1603）に到達。直近のAHCでは78位・黄色パフォーマンスを記録。
      </p>
    </section>

    <section class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-3">
      <div
        class="animate-fade-in-up animation-delay-200 rounded-xl border border-amber-200 bg-amber-50 p-6 opacity-0"
      >
        <h3 class="font-semibold text-amber-800">Algorithm部門</h3>
        <p class="mt-1 text-sm text-amber-600">茶色ランク到達</p>
      </div>

      <div
        class="animate-fade-in-up animation-delay-200 rounded-xl border border-blue-200 bg-blue-50 p-6 opacity-0"
      >
        <h3 class="font-semibold text-blue-800">Heuristic部門</h3>
        <p class="mt-1 text-sm text-blue-600">青色ランク到達（最高レート1603）</p>
      </div>

      <div
        class="animate-fade-in-up animation-delay-200 rounded-xl border border-yellow-200 bg-yellow-50 p-6 opacity-0"
      >
        <h3 class="font-semibold text-yellow-800">AHC最高成績</h3>
        <p class="mt-1 text-sm text-yellow-600">78位・黄色パフォーマンス</p>
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-300 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">使用言語</h2>
      <div class="flex flex-wrap gap-2">
        {
          LANGS.map((name) => {
            const icon = getTechIcon(name);
            return (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1.5 text-sm text-blue-700">
                {icon && <img src={icon} class="h-4 w-4 flex-shrink-0" alt="" loading="lazy" />}
                {name}
              </span>
            );
          })
        }
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-400 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">取り組み方</h2>
      <div class="space-y-4 text-sm text-gray-600">
        <ul class="space-y-2">
          <li>• 毎週開催されるコンテストに参加し、アルゴリズム問題に取り組む</li>
          <li>
            •
            Algorithm部門（アルゴリズムの正確性とスピードを競う）とHeuristic部門（試行錯誤で最適解を探す）の両方に挑戦
          </li>
          <li>• 当初は知らないアルゴリズムばかりで苦戦したが、継続的に学習を続けた</li>
        </ul>
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">工夫した点</h2>
      <div class="space-y-4 text-sm text-gray-600">
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-gray-300">—</span>
            <span>
              わからない部分はAIに質問したり、体系的な書籍（「競技プログラミングの鉄則」など）で学んだりして、効率的に知識を吸収
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-gray-300">—</span>
            <span>
              解けなかった問題は、解説を読んで理解した後に必ず自分で実装し直すことで、知識を定着
            </span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-gray-300">—</span>
            <span>苦手な分野（グラフ、動的計画法など）を特定し、重点的に演習を積んだ</span>
          </li>
        </ul>
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">学び</h2>
      <div class="space-y-3 text-sm text-gray-600">
        <p>
          •
          「わからない」状態から、調べて・試して・理解するというサイクルを回し続けることで、着実に成長できることを実感
        </p>
        <p>• 問題を分解して考える力、効率的なアルゴリズムを選択する力が身についた</p>
        <p>
          • 制限時間内に正確なコードを書くプレッシャーの中で、冷静に思考を整理する力が鍛えられた
        </p>
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 rounded-3xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 text-white opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">リンク</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://atcoder.jp/users/oreccchi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 transition-colors hover:bg-white/20"
        >
          <span class="font-bold">A</span>
          AtCoder Profile
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
