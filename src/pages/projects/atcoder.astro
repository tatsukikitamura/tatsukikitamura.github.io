---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../components/ProjectBackLink.astro';
import { getTechIcon } from '../../lib/techIcons';

const LANGS = ['Python', 'C++'];

const DESCRIPTION =
  '北村健紀の AtCoder 取り組み。Algorithm 茶 / Heuristic 青（最高レート1603）。約2年継続中、AHC78位・黄色パフォーマンス記録。';
---

<BaseLayout
  title="AtCoder - 競技プログラミング"
  description={DESCRIPTION}
  path="/projects/atcoder"
>
  <main class="pt-20 pb-8 px-4 max-w-4xl mx-auto">
    <ProjectBackLink />

    <div class="mb-12 opacity-0 animate-fade-in-up">
      <a
        href="https://atcoder.jp/users/oreccchi"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block group"
      >
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight group-hover:underline underline-offset-4 decoration-2">
          AtCoder
        </h1>
      </a>
      <p class="text-gray-500 mt-2">2024年4月〜2026年1月（継続中）</p>
    </div>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-100">
      <h2 class="text-xl font-bold tracking-tight mb-4">概要</h2>
      <p class="text-gray-600 leading-relaxed">
        AtCoderは、プログラミングの問題を解くスピードと正確性を競うコンテスト。アルゴリズムやデータ構造の知識を活かして、制限時間内に問題を解く形式。継続的に取り組み、Algorithm部門で茶色、Heuristic部門で青色ランク（最高レート1603）に到達。直近のAHCでは78位・黄色パフォーマンスを記録。
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="bg-amber-50 rounded-xl border border-amber-200 p-6 opacity-0 animate-fade-in-up animation-delay-200">
        <h3 class="font-semibold text-amber-800">Algorithm部門</h3>
        <p class="text-amber-600 mt-1 text-sm">茶色ランク到達</p>
      </div>

      <div class="bg-blue-50 rounded-xl border border-blue-200 p-6 opacity-0 animate-fade-in-up animation-delay-200">
        <h3 class="font-semibold text-blue-800">Heuristic部門</h3>
        <p class="text-blue-600 mt-1 text-sm">青色ランク到達（最高レート1603）</p>
      </div>

      <div class="bg-yellow-50 rounded-xl border border-yellow-200 p-6 opacity-0 animate-fade-in-up animation-delay-200">
        <h3 class="font-semibold text-yellow-800">AHC最高成績</h3>
        <p class="text-yellow-600 mt-1 text-sm">78位・黄色パフォーマンス</p>
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-300">
      <h2 class="text-xl font-bold tracking-tight mb-4">使用言語</h2>
      <div class="flex flex-wrap gap-2">
        {LANGS.map((name) => {
          const icon = getTechIcon(name);
          return (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 rounded-full text-sm">
              {icon && (
                <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
              )}
              {name}
            </span>
          );
        })}
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-400">
      <h2 class="text-xl font-bold tracking-tight mb-4">スタイル</h2>
      <div class="space-y-4 text-gray-600 text-sm">
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <span class="text-gray-300 mt-0.5">—</span>
            <span>毎週のコンテストに参加。Algorithm 部門（正確性とスピード）と Heuristic 部門（最適化問題のスコアを試行錯誤で改善）の両方に出場</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-gray-300 mt-0.5">—</span>
            <span>解けなかった問題は、解説を読んで理解した後に必ず自分で実装し直す</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-8 text-white opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">リンク</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://atcoder.jp/users/oreccchi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full hover:bg-white/20 transition-colors"
        >
          <span class="font-bold">A</span>
          AtCoder Profile
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
