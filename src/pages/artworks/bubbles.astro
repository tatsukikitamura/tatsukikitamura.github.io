---
import BaseLayout from '../../layouts/BaseLayout.astro';

const DESCRIPTION =
  '保護フィルムを貼ったときの気泡とりを体験できる実験的な Web ページ。カーソルで気泡を画面の端まで押し出して抜こう。';
---

<BaseLayout title="気泡とり - Artworks" description={DESCRIPTION} path="/artworks/bubbles" frame={false}>
  <div class="relative h-dvh overflow-hidden bg-[#101010] text-[#dfdfd6] select-none">
    <canvas id="bubble-canvas" class="absolute inset-0 h-full w-full"></canvas>

    <!-- 上部の説明 -->
    <div class="pointer-events-none relative z-10 flex items-start justify-between px-6 pt-6">
      <a
        href="/artworks"
        class="pointer-events-auto inline-flex items-center gap-2 font-mono text-sm text-[#98989f] transition-colors hover:text-white"
      >
        <span aria-hidden="true">←</span>
        tatsuki.artworks
      </a>
      <p class="font-mono text-xs text-[#98989f]">
        残り <span id="bubble-count">0</span> 個
      </p>
    </div>

    <p
      class="pointer-events-none absolute bottom-8 left-1/2 z-10 w-max max-w-[90vw] -translate-x-1/2 text-center font-mono text-xs text-[#98989f]/80"
    >
      気泡を画面の端まで押していくと空気が抜ける
    </p>

    <!-- 全部抜けたとき -->
    <div
      id="bubble-done"
      class="pointer-events-none absolute inset-0 z-20 hidden flex-col items-center justify-center gap-6 text-center"
    >
      <p class="text-2xl font-bold text-white md:text-4xl">きれいに貼れました</p>
      <button
        id="bubble-reset"
        class="pointer-events-auto rounded-full border border-white/20 px-5 py-2 font-mono text-sm text-[#dfdfd6] transition-colors hover:border-white/50 hover:text-white"
      >
        もう一回貼る
      </button>
    </div>
  </div>

  <script>
    // 保護フィルムの下に閉じ込められた空気のソフトボディシミュレーション。
    //
    // 気泡 = 質点をバネで輪っかに繋ぎ、内部気圧で膨らませたリング。
    // - 空気の量 (restArea) は保存される: 押すと凹み、その分ほかが膨らんで滑る
    // - 指は膜 (辺) と連続衝突するので、質点の隙間をすり抜けて中に入れない
    // - 画面端 (フィルムの縁) に押し付けて圧縮すると、接触弧の長さ×過圧に応じて空気が漏れる
    // - 気泡同士はポリゴン同士で押し合い、接触が深くなる (めり込む質点が増える) と合体する
    const canvas = document.getElementById('bubble-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    const countEl = document.getElementById('bubble-count');
    const doneEl = document.getElementById('bubble-done');
    const resetEl = document.getElementById('bubble-reset');

    if (canvas && ctx && countEl && doneEl && resetEl) {
      type Point = { x: number; y: number; px: number; py: number };
      type Bubble = { pts: Point[]; restArea: number; dying: boolean; alpha: number };

      const POINTS = 26; // 1気泡あたりの質点数
      const BUBBLE_COUNT = 8;
      const FINGER_R = 9; // カーソル(指)の半径
      const SPRING_ITER = 2;
      const SPRING_STIFF = 0.5;
      const BEND_STIFF = 0.15; // 曲げ剛性 (1つ飛ばしのバネ)。膜が波打つのを抑える
      const PRESSURE_K = 0.06; // 気圧による復元の強さ
      const DAMPING = 0.55; // フィルムとの摩擦。小さいほど滑らず、押すのをやめるとすぐ止まる
      const SUBSTEPS = 3; // カーソルが速く動いてもすり抜けないよう分割
      const MIN_AREA = 320; // これ以下まで空気が漏れたら「抜けた」
      const MERGE_CONTACT = 6; // 互いにめり込んだ質点の合計がこれ以上で合体
      const LEAK_BASE = 0.002; // 縁に触れているだけで漏れる基礎量 (px あたり)
      const LEAK_PRESS = 0.9; // 過圧 1.0 のときの漏れ量 (px あたり)

      let bubbles: Bubble[] = [];
      let pointerX = -9999;
      let pointerY = -9999;
      let prevPointerX = -9999;
      let prevPointerY = -9999;
      let interacted = false;
      let spawnW = 0;
      let spawnH = 0;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const resize = () => {
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize);

      const makeBubble = (cx: number, cy: number, r: number): Bubble => {
        const pts: Point[] = [];
        for (let i = 0; i < POINTS; i++) {
          const a = (i / POINTS) * Math.PI * 2;
          const x = cx + Math.cos(a) * r;
          const y = cy + Math.sin(a) * r;
          pts.push({ x, y, px: x, py: y });
        }
        return { pts, restArea: Math.PI * r * r, dying: false, alpha: 1 };
      };

      // 合体直後の気泡: 2つの円の和集合 (ピーナッツ型) の輪郭から質点リングを作る。
      // 和集合の面積は restArea (空気の合計) より小さいので、内部気圧が
      // くびれた形を少しずつ丸く膨らませていく
      const makeMergedBubble = (
        cax: number,
        cay: number,
        ra: number,
        cbx: number,
        cby: number,
        rb: number,
        totalRestArea: number
      ): Bubble => {
        const total = ra * ra + rb * rb;
        const mx = (cax * ra * ra + cbx * rb * rb) / total;
        const my = (cay * ra * ra + cby * rb * rb) / total;

        // 中心から各方向へレイを飛ばし、2円のうち遠い方の交点までを半径にする
        const rayHit = (dx: number, dy: number, cx: number, cy: number, r: number) => {
          const fx = cx - mx;
          const fy = cy - my;
          const b = fx * dx + fy * dy;
          const disc = b * b - (fx * fx + fy * fy - r * r);
          if (disc < 0) return 0;
          return b + Math.sqrt(disc);
        };

        const pts: Point[] = [];
        for (let i = 0; i < POINTS; i++) {
          const a = (i / POINTS) * Math.PI * 2;
          const dx = Math.cos(a);
          const dy = Math.sin(a);
          const t = Math.max(rayHit(dx, dy, cax, cay, ra), rayHit(dx, dy, cbx, cby, rb), 4);
          const x = mx + dx * t;
          const y = my + dy * t;
          pts.push({ x, y, px: x, py: y });
        }
        return { pts, restArea: totalRestArea, dying: false, alpha: 1 };
      };

      // 符号付き面積。健全なリングは正。絡まる・裏返ると 0 や負に近づく
      const signedArea = (pts: Point[]) => {
        let s = 0;
        for (let i = 0; i < pts.length; i++) {
          const p = pts[i];
          const q = pts[(i + 1) % pts.length];
          s += p.x * q.y - q.x * p.y;
        }
        return s / 2;
      };
      const area = (pts: Point[]) => Math.abs(signedArea(pts));

      const centroid = (pts: Point[]) => {
        let x = 0;
        let y = 0;
        for (const p of pts) {
          x += p.x;
          y += p.y;
        }
        return { x: x / pts.length, y: y / pts.length };
      };

      const pointInPoly = (x: number, y: number, pts: Point[]) => {
        let inside = false;
        for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
          const pi = pts[i];
          const pj = pts[j];
          if (pi.y > y !== pj.y > y && x < ((pj.x - pi.x) * (y - pi.y)) / (pj.y - pi.y) + pi.x) {
            inside = !inside;
          }
        }
        return inside;
      };

      // 点 (x,y) から線分 pq への最近点とその線分内パラメータ t
      const closestOnSeg = (x: number, y: number, p: Point, q: Point) => {
        const dx = q.x - p.x;
        const dy = q.y - p.y;
        const len2 = dx * dx + dy * dy || 0.001;
        const t = Math.min(1, Math.max(0, ((x - p.x) * dx + (y - p.y) * dy) / len2));
        return { x: p.x + dx * t, y: p.y + dy * t, t };
      };

      const updateCount = () => {
        const alive = bubbles.filter((b) => !b.dying).length;
        countEl.textContent = String(alive);
        if (alive === 0) {
          doneEl.classList.remove('hidden');
          doneEl.classList.add('flex');
        }
      };

      const spawn = () => {
        bubbles = [];
        doneEl.classList.add('hidden');
        doneEl.classList.remove('flex');
        const w = window.innerWidth;
        const h = window.innerHeight;
        spawnW = w;
        spawnH = h;
        for (let i = 0; i < BUBBLE_COUNT; i++) {
          let r = 28 + Math.random() * 26;
          let placed = false;
          // 置けなければ半径を縮めて再試行。それでも無理なら重ねて置かずに諦める
          for (let shrink = 0; shrink < 3 && !placed; shrink++) {
            for (let attempt = 0; attempt < 16; attempt++) {
              const cx = r * 2 + Math.random() * Math.max(w - r * 4, 1);
              const cy = r * 2 + Math.random() * Math.max(h - r * 4, 1);
              const ok = bubbles.every((b) => {
                const c = centroid(b.pts);
                const br = Math.sqrt(b.restArea / Math.PI);
                return Math.hypot(c.x - cx, c.y - cy) > (r + br) * 1.3;
              });
              if (ok) {
                bubbles.push(makeBubble(cx, cy, r));
                placed = true;
                break;
              }
            }
            if (!placed) r *= 0.8;
          }
        }
        updateCount();
      };

      window.addEventListener('pointermove', (event) => {
        // 画面外から入ってきた直後は「前回位置」も現在地に合わせ、
        // 指が画面を横切ってワープしたことにならないようにする
        if (pointerX === -9999) {
          prevPointerX = event.clientX;
          prevPointerY = event.clientY;
        }
        pointerX = event.clientX;
        pointerY = event.clientY;
        interacted = true;
      });
      window.addEventListener('pointerleave', () => {
        pointerX = -9999;
        pointerY = -9999;
      });
      resetEl.addEventListener('click', spawn);

      const stepBubble = (b: Bubble, fingerX: number, fingerY: number) => {
        const w = window.innerWidth;
        const h = window.innerHeight;
        const pts = b.pts;

        // 抜けた気泡は縮みながら消えるだけ
        if (b.dying) {
          const c = centroid(pts);
          for (const p of pts) {
            p.x += (c.x - p.x) * 0.18;
            p.y += (c.y - p.y) * 0.18;
          }
          b.alpha *= 0.88;
          return;
        }

        // 慣性 (Verlet) + 減衰
        for (const p of pts) {
          const vx = (p.x - p.px) * DAMPING;
          const vy = (p.y - p.py) * DAMPING;
          p.px = p.x;
          p.py = p.y;
          p.x += vx;
          p.y += vy;
        }

        // 指 (カーソル) は膜 (辺) と衝突する。点ではなく辺で判定するので、
        // 質点の隙間をすり抜けて気泡の中に入ることがない
        if (pointInPoly(fingerX, fingerY, pts)) {
          // 万一中に入ってしまったときの復帰: 気泡を少しずつずらして指を外に出す
          const c = centroid(pts);
          let ux = c.x - fingerX;
          let uy = c.y - fingerY;
          const ul = Math.hypot(ux, uy) || 1;
          ux /= ul;
          uy /= ul;
          for (const p of pts) {
            p.x += ux * FINGER_R * 0.4;
            p.y += uy * FINGER_R * 0.4;
          }
        } else {
          const MAX_PUSH = FINGER_R * 0.4;
          for (let i = 0; i < POINTS; i++) {
            const p = pts[i];
            const q = pts[(i + 1) % POINTS];
            const cp = closestOnSeg(fingerX, fingerY, p, q);
            const dx = cp.x - fingerX;
            const dy = cp.y - fingerY;
            const d = Math.hypot(dx, dy);
            if (d < FINGER_R && d > 0.001) {
              const corr = Math.min(FINGER_R - d, MAX_PUSH);
              const nx = dx / d;
              const ny = dy / d;
              // 最近点が動くように、辺の両端へ位置の重みで分配する
              const wp = 1 - cp.t;
              const wq = cp.t;
              const scale = 1 / (wp * wp + wq * wq);
              p.x += nx * corr * wp * scale * 0.5;
              p.y += ny * corr * wp * scale * 0.5;
              q.x += nx * corr * wq * scale * 0.5;
              q.y += ny * corr * wq * scale * 0.5;
            }
          }
        }

        // 周のバネ (表面張力) + 1つ飛ばしのバネ (フィルムの曲げ剛性)
        const R = Math.sqrt(b.restArea / Math.PI);
        const restLen = (2 * Math.PI * R) / POINTS;
        const bendLen = 2 * R * Math.sin((Math.PI * 2) / POINTS);
        for (let iter = 0; iter < SPRING_ITER; iter++) {
          for (let i = 0; i < POINTS; i++) {
            const p = pts[i];
            const q = pts[(i + 1) % POINTS];
            const dx = q.x - p.x;
            const dy = q.y - p.y;
            const d = Math.hypot(dx, dy) || 0.001;
            const diff = ((d - restLen) / d) * SPRING_STIFF * 0.5;
            p.x += dx * diff;
            p.y += dy * diff;
            q.x -= dx * diff;
            q.y -= dy * diff;
          }
          for (let i = 0; i < POINTS; i++) {
            const p = pts[i];
            const q = pts[(i + 2) % POINTS];
            const dx = q.x - p.x;
            const dy = q.y - p.y;
            const d = Math.hypot(dx, dy) || 0.001;
            const diff = ((d - bendLen) / d) * BEND_STIFF * 0.5;
            p.x += dx * diff;
            p.y += dy * diff;
            q.x -= dx * diff;
            q.y -= dy * diff;
          }
        }

        // 内部気圧: 空気の量 (restArea) と今の面積の差で外向き/内向きに押す
        const currentArea = area(pts);
        const pressure = ((b.restArea - currentArea) / b.restArea) * PRESSURE_K;
        for (let i = 0; i < POINTS; i++) {
          const prev = pts[(i - 1 + POINTS) % POINTS];
          const next = pts[(i + 1) % POINTS];
          // 隣接2点から外向き法線を作る
          let nx = next.y - prev.y;
          let ny = -(next.x - prev.x);
          const nl = Math.hypot(nx, ny) || 0.001;
          nx /= nl;
          ny /= nl;
          pts[i].x += nx * pressure * restLen * 2;
          pts[i].y += ny * pressure * restLen * 2;
        }

        // 自己交差の回復: リングが絡まる・裏返ると符号付き面積が潰れる。
        // そうなったらその場で円に組み直す (空気の量は保存)
        if (signedArea(pts) < b.restArea * 0.05) {
          const c = centroid(pts);
          const rr = Math.max(Math.sqrt(area(pts) / Math.PI), 6);
          for (let i = 0; i < POINTS; i++) {
            const a = (i / POINTS) * Math.PI * 2;
            const p = pts[i];
            p.x = c.x + Math.cos(a) * rr;
            p.y = c.y + Math.sin(a) * rr;
            p.px = p.x;
            p.py = p.y;
          }
        }

        // フィルムの縁 (画面端): 質点は外に出られない。
        // 縁に触れた接触弧の長さ × 過圧に応じて空気が漏れる
        const clamped: boolean[] = new Array(POINTS);
        for (let i = 0; i < POINTS; i++) {
          const p = pts[i];
          const cx2 = Math.min(Math.max(p.x, 0), w);
          const cy2 = Math.min(Math.max(p.y, 0), h);
          clamped[i] = cx2 !== p.x || cy2 !== p.y;
          p.x = cx2;
          p.y = cy2;
        }
        let contactLen = 0;
        for (let i = 0; i < POINTS; i++) {
          if (clamped[i] && clamped[(i + 1) % POINTS]) {
            const p = pts[i];
            const q = pts[(i + 1) % POINTS];
            contactLen += Math.hypot(q.x - p.x, q.y - p.y);
          }
        }
        if (contactLen > 0) {
          const overpressure = Math.max(0, (b.restArea - currentArea) / b.restArea);
          b.restArea -= contactLen * (LEAK_BASE + overpressure * LEAK_PRESS);
          if (b.restArea <= MIN_AREA) {
            b.dying = true;
            updateCount();
          }
        }
      };

      const collideAndMerge = () => {
        for (let i = 0; i < bubbles.length; i++) {
          for (let j = i + 1; j < bubbles.length; j++) {
            const a1 = bubbles[i];
            const b1 = bubbles[j];
            if (a1.dying || b1.dying) continue;
            const ca = centroid(a1.pts);
            const cb = centroid(b1.pts);
            const ra = Math.sqrt(area(a1.pts) / Math.PI);
            const rb = Math.sqrt(area(b1.pts) / Math.PI);

            // ブロードフェーズ: 等価円が離れていれば何もしない
            if (Math.hypot(cb.x - ca.x, cb.y - ca.y) > (ra + rb) * 1.2) continue;

            // ナローフェーズ: 相手のポリゴンにめり込んだ質点を、
            // 最近傍の辺へ押し戻す。辺の側にも反作用を与える
            let contacts = 0;
            const resolve = (self: Bubble, other: Bubble) => {
              for (const p of self.pts) {
                if (!pointInPoly(p.x, p.y, other.pts)) continue;
                contacts++;
                let bestD = Infinity;
                let bestX = p.x;
                let bestY = p.y;
                let bestI = 0;
                let bestT = 0;
                for (let k = 0; k < POINTS; k++) {
                  const e1 = other.pts[k];
                  const e2 = other.pts[(k + 1) % POINTS];
                  const cp = closestOnSeg(p.x, p.y, e1, e2);
                  const d = Math.hypot(cp.x - p.x, cp.y - p.y);
                  if (d < bestD) {
                    bestD = d;
                    bestX = cp.x;
                    bestY = cp.y;
                    bestI = k;
                    bestT = cp.t;
                  }
                }
                const nx = bestX - p.x;
                const ny = bestY - p.y;
                const nl = Math.hypot(nx, ny) || 0.001;
                // 半分ずつ: めり込んだ質点は境界へ、辺の両端は反対へ
                p.x += (nx / nl) * bestD * 0.5;
                p.y += (ny / nl) * bestD * 0.5;
                const e1 = other.pts[bestI];
                const e2 = other.pts[(bestI + 1) % POINTS];
                e1.x -= (nx / nl) * bestD * 0.25 * (1 - bestT);
                e1.y -= (ny / nl) * bestD * 0.25 * (1 - bestT);
                e2.x -= (nx / nl) * bestD * 0.25 * bestT;
                e2.y -= (ny / nl) * bestD * 0.25 * bestT;
              }
            };
            resolve(a1, b1);
            resolve(b1, a1);

            // 接触が深い (めり込む質点が多い = 間のフィルムが広く潰れている) と合体
            if (contacts >= MERGE_CONTACT) {
              const merged = makeMergedBubble(
                ca.x,
                ca.y,
                ra,
                cb.x,
                cb.y,
                rb,
                a1.restArea + b1.restArea
              );
              bubbles.splice(j, 1);
              bubbles.splice(i, 1, merged);
              updateCount();
              j = i; // 合体後は同じ i からやり直す
            }
          }
        }
      };

      // 光源の向き (左上から)。縁のハイライトに方向性を出す
      const LIGHT_X = -0.6;
      const LIGHT_Y = -0.8;

      const drawBubble = (b: Bubble) => {
        const pts = b.pts;
        const mid = (p: Point, q: Point) => ({ x: (p.x + q.x) / 2, y: (p.y + q.y) / 2 });
        ctx.globalAlpha = b.alpha;

        // 質点の中点を通る滑らかな閉曲線
        const tracePath = () => {
          ctx.beginPath();
          let m = mid(pts[POINTS - 1], pts[0]);
          ctx.moveTo(m.x, m.y);
          for (let i = 0; i < POINTS; i++) {
            const p = pts[i];
            const next = pts[(i + 1) % POINTS];
            m = mid(p, next);
            ctx.quadraticCurveTo(p.x, p.y, m.x, m.y);
          }
          ctx.closePath();
        };

        const c = centroid(pts);
        const r = Math.max(Math.sqrt(area(pts) / Math.PI), 1);

        // 内部はほぼ透明。フィルムが浮いているぶん、縁に近いほど微かに明るい
        tracePath();
        const lens = ctx.createRadialGradient(c.x, c.y, r * 0.2, c.x, c.y, r);
        lens.addColorStop(0, 'rgba(255, 255, 255, 0.012)');
        lens.addColorStop(0.8, 'rgba(255, 255, 255, 0.03)');
        lens.addColorStop(1, 'rgba(255, 255, 255, 0.07)');
        ctx.fillStyle = lens;
        ctx.fill();

        // 縁: フィルムが浮いた境界のリム。光源側が明るく、反対側は薄い。
        // セグメントごとに法線と光源の内積で明るさを変える
        const lit: number[] = new Array(POINTS);
        for (let i = 0; i < POINTS; i++) {
          const p = pts[i];
          const next = pts[(i + 1) % POINTS];
          const prev = pts[(i - 1 + POINTS) % POINTS];
          let nx = next.y - prev.y;
          let ny = -(next.x - prev.x);
          const nl = Math.hypot(nx, ny) || 0.001;
          nx /= nl;
          ny /= nl;
          lit[i] = Math.max(0, nx * LIGHT_X + ny * LIGHT_Y);

          const m1 = mid(prev, p);
          const m2 = mid(p, next);
          ctx.beginPath();
          ctx.moveTo(m1.x, m1.y);
          ctx.quadraticCurveTo(p.x, p.y, m2.x, m2.y);

          // 薄く広い滲み + 細く鋭いリムの二重描き
          ctx.strokeStyle = `rgba(255, 255, 255, ${0.03 + lit[i] * 0.08})`;
          ctx.lineWidth = 3.5;
          ctx.stroke();
          ctx.strokeStyle = `rgba(255, 255, 255, ${0.12 + lit[i] * 0.45})`;
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }

        // グリント: 法線が光源を向く「山」ごとに描く。
        // ピーナッツ型ならローブごとに 1 個ずつ出る
        for (let i = 0; i < POINTS; i++) {
          const before = lit[(i - 1 + POINTS) % POINTS];
          const after = lit[(i + 1) % POINTS];
          if (lit[i] < 0.55 || lit[i] < before || lit[i] <= after) continue;
          const gp = pts[i];
          const gx = c.x + (gp.x - c.x) * 0.82;
          const gy = c.y + (gp.y - c.y) * 0.82;
          const gr = Math.max(r * 0.15, 3);
          const glint = ctx.createRadialGradient(gx, gy, 0, gx, gy, gr);
          glint.addColorStop(0, `rgba(255, 255, 255, ${0.5 * lit[i]})`);
          glint.addColorStop(1, 'rgba(255, 255, 255, 0)');
          ctx.fillStyle = glint;
          ctx.beginPath();
          ctx.arc(gx, gy, gr, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.globalAlpha = 1;
      };

      const tick = () => {
        // ロード直後はビューポートのサイズが確定していないことがある。
        // まだ操作していないのにサイズが変わっていたら配置し直す
        if (!interacted && (window.innerWidth !== spawnW || window.innerHeight !== spawnH)) {
          spawn();
        }

        // カーソルが速く動いた場合は移動を分割して、気泡のすり抜けを防ぐ
        for (let s = 1; s <= SUBSTEPS; s++) {
          const fx = prevPointerX + ((pointerX - prevPointerX) * s) / SUBSTEPS;
          const fy = prevPointerY + ((pointerY - prevPointerY) * s) / SUBSTEPS;
          for (const b of bubbles) stepBubble(b, fx, fy);
          collideAndMerge();
        }
        prevPointerX = pointerX;
        prevPointerY = pointerY;

        // 縮みきった気泡を配列から外す (カウントは dying になった時点で減っている)
        bubbles = bubbles.filter((b) => !b.dying || b.alpha > 0.04);

        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        for (const b of bubbles) drawBubble(b);
        requestAnimationFrame(tick);
      };

      spawn();
      requestAnimationFrame(tick);
    }
  </script>
</BaseLayout>
