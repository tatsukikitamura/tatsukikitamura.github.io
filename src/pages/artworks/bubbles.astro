---
import BaseLayout from '../../layouts/BaseLayout.astro';

const DESCRIPTION =
  '保護フィルムを貼ったときの気泡とりを体験できる実験的な Web ページ。カーソルで気泡を画面の端まで押し出して抜こう。';
---

<BaseLayout title="気泡とり - Artworks" description={DESCRIPTION} path="/artworks/bubbles" frame={false}>
  <div class="relative h-dvh overflow-hidden bg-[#101010] text-[#dfdfd6] select-none">
    <canvas id="bubble-canvas" class="absolute inset-0 h-full w-full"></canvas>

    <!-- 上部の説明 -->
    <div class="pointer-events-none relative z-10 flex items-start justify-between px-6 pt-6">
      <a
        href="/artworks"
        class="pointer-events-auto inline-flex items-center gap-2 font-mono text-sm text-[#98989f] transition-colors hover:text-white"
      >
        <span aria-hidden="true">←</span>
        tatsuki.artworks
      </a>
      <p class="font-mono text-xs text-[#98989f]">
        残り <span id="bubble-count">0</span> 個
      </p>
    </div>

    <p
      class="pointer-events-none absolute bottom-8 left-1/2 z-10 w-max max-w-[90vw] -translate-x-1/2 text-center font-mono text-xs text-[#98989f]/80"
    >
      気泡を画面の端まで押していくと空気が抜ける
    </p>

    <!-- 全部抜けたとき -->
    <div
      id="bubble-done"
      class="pointer-events-none absolute inset-0 z-20 hidden flex-col items-center justify-center gap-6 text-center"
    >
      <p class="text-2xl font-bold text-white md:text-4xl">きれいに貼れました</p>
      <button
        id="bubble-reset"
        class="pointer-events-auto rounded-full border border-white/20 px-5 py-2 font-mono text-sm text-[#dfdfd6] transition-colors hover:border-white/50 hover:text-white"
      >
        もう一回貼る
      </button>
    </div>
  </div>

  <script>
    import { startBubbleSimulation } from '../../lib/bubbleSimulation';
    startBubbleSimulation();
  </script>
</BaseLayout>
