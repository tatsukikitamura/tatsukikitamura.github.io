---
import { localePaths, localeFromParam } from '../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProblemTerminal from '../../islands/ProblemTerminal.tsx';
import problemDict from '../../i18n/dict/problem';

const locale = localeFromParam(Astro.params.lang);
const t = problemDict[locale];
---

<BaseLayout title={t.title} description={t.description} path="/problem">
  <main class="px-6 pt-24 pb-16">
    <div class="mx-auto max-w-4xl">
      <PageHeader command="open -a Terminal problems/">{t.heading}</PageHeader>
      <ProblemTerminal client:load locale={locale} />
    </div>
  </main>
</BaseLayout>
