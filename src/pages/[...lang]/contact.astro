---
import { localePaths, localeFromParam } from '../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { GitHubIcon, InstagramIcon, MailIcon } from '../../components/Icons';
import { getTechIcon } from '../../lib/techIcons';
import contactDict from '../../i18n/dict/contact';

const locale = localeFromParam(Astro.params.lang);
const t = contactDict[locale];

const TECH_STACK = {
  frontend: ['React', 'TypeScript', 'Vite', 'Tailwind CSS', 'Next.js', 'Astro'],
  backend: ['Ruby on Rails', 'Python', 'PostgreSQL', 'MySQL'],
  infra: ['GitHub Pages', 'Vercel', 'AWS', 'Docker', 'Git'],
};
---

<BaseLayout title={t.title} description={t.description} path="/contact">
  <main class="pt-24 pb-8 px-4 max-w-4xl mx-auto">
    <PageHeader command="cat contact.md">
      {t.heading.line1}<br class="sm:hidden" />{t.heading.line2}
    </PageHeader>

    <section class="px-2 text-zinc-700 mb-12 opacity-0 animate-fade-in-up animation-delay-100">
      <h2 class="text-2xl font-bold mb-4">{t.intro.heading}</h2>
      <p class="leading-relaxed">
        {t.intro.lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </section>

    <section class="px-2 mb-12 opacity-0 animate-fade-in-up animation-delay-200">
      <h2 class="text-xl font-bold tracking-tight mb-2">{t.services.heading}</h2>
      <p class="text-sm text-gray-500 mb-6">{t.services.lead}</p>
      <div class="grid md:grid-cols-2 gap-4">
        {t.services.items.map((item) => (
          <div class="border border-gray-200 rounded-2xl p-5 hover:border-gray-400 transition-colors">
            <span class="inline-block text-[10px] font-semibold tracking-wider text-indigo-600 bg-indigo-50 rounded-full px-2 py-0.5 mb-2">
              {item.tag}
            </span>
            <h3 class="font-semibold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed mb-3">{item.desc}</p>
            <ul class="space-y-1">
              {item.points.map((p) => (
                <li class="text-xs text-gray-600 flex items-start gap-1.5">
                  <span class="text-indigo-500 mt-0.5">▸</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-500 mt-5">{t.services.note}</p>
    </section>

    <section class="px-2 mb-12 opacity-0 animate-fade-in-up animation-delay-300">
      <h2 class="text-xl font-bold tracking-tight mb-6">{t.flow.heading}</h2>
      <ol class="grid md:grid-cols-2 gap-4">
        {t.flow.steps.map((step, i) => (
          <li class="border border-gray-200 rounded-2xl p-5 flex gap-4">
            <div class="flex-shrink-0 w-9 h-9 rounded-full bg-gray-900 text-white text-sm font-semibold flex items-center justify-center">
              {i + 1}
            </div>
            <div class="min-w-0">
              <h3 class="font-semibold text-gray-900 mb-1">{step.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-2">{step.desc}</p>
              <p class="text-xs text-gray-500">{step.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="px-2 mb-12 opacity-0 animate-fade-in-up animation-delay-400">
      <h2 class="text-xl font-bold tracking-tight mb-6">{t.tech.heading}</h2>
      <div class="space-y-5">
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-2 tracking-wide">{t.tech.frontend}</p>
          <div class="flex flex-wrap gap-2">
            {TECH_STACK.frontend.map((name) => {
              const icon = getTechIcon(name);
              return (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium bg-indigo-50 text-indigo-700">
                  {icon && (
                    <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
                  )}
                  {name}
                </span>
              );
            })}
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-2 tracking-wide">{t.tech.backend}</p>
          <div class="flex flex-wrap gap-2">
            {TECH_STACK.backend.map((name) => {
              const icon = getTechIcon(name);
              return (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium bg-emerald-50 text-emerald-700">
                  {icon && (
                    <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
                  )}
                  {name}
                </span>
              );
            })}
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold text-gray-500 mb-2 tracking-wide">{t.tech.infra}</p>
          <div class="flex flex-wrap gap-2">
            {TECH_STACK.infra.map((name) => {
              const icon = getTechIcon(name);
              return (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium bg-amber-50 text-amber-700">
                  {icon && (
                    <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
                  )}
                  {name}
                </span>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="px-2 mb-12 opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.pricing.heading}</h2>
      <div class="space-y-4 text-gray-700 leading-relaxed">
        <p>
          {t.pricing.main.before}<span class="font-semibold text-gray-900">{t.pricing.main.emph}</span>{t.pricing.main.after}
        </p>
        <p class="text-sm text-gray-600">
          {t.pricing.detail}
          <br />
          <span class="font-medium text-gray-800">{t.pricing.freeEmph}</span>
          {t.pricing.freeAfter}
        </p>
      </div>

      <div class="mt-6 rounded-2xl border border-gray-200 bg-gray-50 p-5">
        <p class="text-xs font-semibold text-gray-500 tracking-wide mb-3">
          {t.pricing.extrasHeading}
        </p>
        <ul class="space-y-1.5 text-sm text-gray-700">
          {t.pricing.extras.map((item) => (
            <li class="flex items-start gap-2">
              <span class="text-gray-400 mt-0.5">▸</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="px-2 mb-12 opacity-0 animate-fade-in-up animation-delay-600">
      <h2 class="text-xl font-bold tracking-tight mb-2">{t.contact.heading}</h2>
      <p class="text-sm text-gray-500 mb-6">{t.contact.lead}</p>

      <div class="flex flex-col sm:flex-row gap-3 mb-5">
        <a
          href="https://instagram.com/t4t2uk1/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-tr from-[#feda75] via-[#d62976] to-[#4f5bd5] text-white rounded-full font-medium hover:opacity-90 transition-opacity"
        >
          <InstagramIcon />
          {t.contact.instagram}
        </a>
        <a
          href="mailto:tatukikitamura123456@gmail.com"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-full font-medium hover:bg-gray-800 transition-colors"
        >
          <MailIcon />
          {t.contact.mail}
        </a>
        <a
          href="https://github.com/tatsukikitamura"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white border border-gray-200 text-gray-900 rounded-full font-medium hover:bg-gray-50 transition-colors"
        >
          <GitHubIcon />
          {t.contact.github}
        </a>
      </div>
    </section>

    <section class="px-2 opacity-0 animate-fade-in-up animation-delay-800">
      <h2 class="text-xl font-bold tracking-tight mb-6">{t.faq.heading}</h2>
      <dl class="divide-y divide-gray-100">
        {t.faq.items.map((item) => (
          <div class="py-4 first:pt-0 last:pb-0">
            <dt class="font-semibold text-gray-900 mb-2 flex gap-2">
              <span class="text-indigo-500 flex-shrink-0">Q.</span>
              <span>{item.q}</span>
            </dt>
            <dd class="text-sm text-gray-600 leading-relaxed flex gap-2">
              <span class="text-gray-400 flex-shrink-0">A.</span>
              <span>{item.a}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </main>
</BaseLayout>
