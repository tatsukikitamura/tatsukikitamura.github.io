---
import { localePaths, localeFromParam } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import {
  LocationIcon,
  EduIcon,
  CodeIcon,
  LangIcon,
  GitHubIcon,
  AtCoderIcon,
} from '../../components/Icons';
import aboutDict from '../../i18n/dict/about';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFromParam(Astro.params.lang);
const t = aboutDict[locale];

const DI = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';
// OpenAI isn't part of devicon, so its logo comes from simple-icons instead.
const SI = 'https://cdn.jsdelivr.net/npm/simple-icons@v13/icons';

type TechItem = {
  name: string;
  icon: string | null;
  bg: string;
  text: string;
};

const TECH_STACK: Record<string, TechItem[]> = {
  languages: [
    { name: 'Ruby', icon: `${DI}/ruby/ruby-original.svg`, bg: 'bg-red-50', text: 'text-red-700' },
    {
      name: 'Python',
      icon: `${DI}/python/python-original.svg`,
      bg: 'bg-blue-50',
      text: 'text-blue-700',
    },
    {
      name: 'JavaScript',
      icon: `${DI}/javascript/javascript-original.svg`,
      bg: 'bg-yellow-50',
      text: 'text-yellow-700',
    },
    {
      name: 'C++',
      icon: `${DI}/cplusplus/cplusplus-original.svg`,
      bg: 'bg-gray-100',
      text: 'text-gray-700',
    },
  ],
  frameworks: [
    {
      name: 'Ruby on Rails',
      icon: `${DI}/rails/rails-plain.svg`,
      bg: 'bg-red-50',
      text: 'text-red-700',
    },
    {
      name: 'FastAPI',
      icon: `${DI}/fastapi/fastapi-original.svg`,
      bg: 'bg-green-50',
      text: 'text-green-700',
    },
    {
      name: 'React',
      icon: `${DI}/react/react-original.svg`,
      bg: 'bg-cyan-50',
      text: 'text-cyan-700',
    },
    { name: 'Stimulus', icon: null, bg: 'bg-orange-50', text: 'text-orange-700' },
  ],
  databases: [
    {
      name: 'PostgreSQL',
      icon: `${DI}/postgresql/postgresql-original.svg`,
      bg: 'bg-blue-50',
      text: 'text-blue-700',
    },
    {
      name: 'SQLite3',
      icon: `${DI}/sqlite/sqlite-original.svg`,
      bg: 'bg-gray-100',
      text: 'text-gray-700',
    },
  ],
  infra: [
    {
      name: 'Docker',
      icon: `${DI}/docker/docker-original.svg`,
      bg: 'bg-blue-50',
      text: 'text-blue-700',
    },
    {
      name: 'Docker Compose',
      icon: `${DI}/docker/docker-original.svg`,
      bg: 'bg-gray-100',
      text: 'text-gray-700',
    },
    {
      name: 'Git',
      icon: `${DI}/git/git-original.svg`,
      bg: 'bg-orange-50',
      text: 'text-orange-700',
    },
    {
      name: 'GitHub',
      icon: `${DI}/github/github-original.svg`,
      bg: 'bg-gray-100',
      text: 'text-gray-700',
    },
    { name: 'Cursor', icon: null, bg: 'bg-purple-50', text: 'text-purple-700' },
  ],
  ai: [
    { name: 'OpenAI API', icon: `${SI}/openai.svg`, bg: 'bg-green-50', text: 'text-green-700' },
    { name: 'LangChain', icon: null, bg: 'bg-orange-50', text: 'text-orange-700' },
  ],
};

const TECH_GROUPS: { label: string; items: TechItem[] }[] = [
  { label: t.tech.groups.languages, items: TECH_STACK.languages! },
  { label: t.tech.groups.frameworks, items: TECH_STACK.frameworks! },
  { label: t.tech.groups.databases, items: TECH_STACK.databases! },
  { label: t.tech.groups.infra, items: TECH_STACK.infra! },
  { label: t.tech.groups.ai, items: TECH_STACK.ai! },
];
---

<BaseLayout title={t.title} description={t.description} path="/about">
  <div class="px-6 pt-24 pb-16">
    <div class="mx-auto max-w-3xl">
      <PageHeader command="cat about.md" subtitle={t.subtitle}>{t.heading}</PageHeader>

      <section
        class="animate-fade-in animation-delay-100 mb-5 rounded-xl border border-gray-200 bg-white p-6"
      >
        <h2 class="mb-4 font-semibold text-gray-900">{t.profile.heading}</h2>
        <div class="space-y-2.5">
          <div class="flex items-center gap-2.5 text-sm text-gray-600">
            <span class="text-gray-400"><LocationIcon /></span>
            <span>{t.profile.location}</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-600">
            <span class="text-gray-400"><EduIcon /></span>
            <span>{t.profile.education}</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-600">
            <span class="text-gray-400"><CodeIcon /></span>
            <span>{t.profile.coding}</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-600">
            <span class="text-gray-400"><LangIcon /></span>
            <span>{t.profile.language}</span>
          </div>
        </div>
        <div class="mt-5 flex items-center gap-4">
          <a
            href="https://github.com/tatsukikitamura"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 transition-colors hover:text-gray-700"
            aria-label="GitHub"
          >
            <GitHubIcon />
          </a>
          <a
            href="https://atcoder.jp/users/oreccchi"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-400 transition-colors hover:text-gray-700"
            aria-label="AtCoder"
          >
            <AtCoderIcon />
          </a>
        </div>
      </section>

      <section
        class="animate-fade-in animation-delay-200 mb-5 rounded-xl border border-gray-200 bg-white p-6"
      >
        <h2 class="mb-4 font-semibold text-gray-900">{t.origin.heading}</h2>
        <div class="space-y-3 text-sm leading-relaxed text-gray-600">
          {t.origin.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section
        class="animate-fade-in animation-delay-300 mb-5 rounded-xl border border-gray-200 bg-white p-6"
      >
        <h2 class="mb-5 font-semibold text-gray-900">{t.tech.heading}</h2>
        <div class="space-y-5">
          {
            TECH_GROUPS.map((group) => (
              <div>
                <h3 class="mb-2.5 text-xs font-semibold tracking-wide text-gray-400 uppercase">
                  {group.label}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span
                      class={`inline-flex items-center gap-1.5 px-2.5 py-1 ${item.bg} ${item.text} rounded text-xs font-medium`}
                    >
                      {item.icon && (
                        <img
                          src={item.icon}
                          class="h-3.5 w-3.5 flex-shrink-0"
                          alt=""
                          loading="lazy"
                        />
                      )}
                      {item.name}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
