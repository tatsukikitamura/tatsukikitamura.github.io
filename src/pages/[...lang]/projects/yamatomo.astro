---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import MacbookFrame from '../../../components/MacbookFrame.astro';
import { getTechIcon } from '../../../lib/techIcons';
import common from '../../../i18n/dict/common';
import yamatomoDict from '../../../i18n/dict/yamatomo';

const locale = localeFromParam(Astro.params.lang);
const c = common[locale];
const t = yamatomoDict[locale];

const iosStack = [
  { name: 'SwiftUI', cls: 'bg-orange-50 text-orange-700' },
  { name: 'Firebase', cls: 'bg-amber-50 text-amber-700' },
  { name: 'OpenAI API', cls: 'bg-gray-100 text-gray-700' },
];
const webStack = [
  { name: 'React', cls: 'bg-sky-50 text-sky-700' },
  { name: 'TypeScript', cls: 'bg-blue-50 text-blue-700' },
  { name: 'Firebase', cls: 'bg-amber-50 text-amber-700' },
  { name: 'Tailwind CSS', cls: 'bg-cyan-50 text-cyan-700' },
  { name: 'Vite', cls: 'bg-purple-50 text-purple-700' },
];

const stackGroups = [
  { label: t.stack.ios, items: iosStack },
  { label: t.stack.web, items: webStack },
];
---

<BaseLayout title={t.title} description={t.description} path="/projects/yamatomo">
  <main class="mx-auto max-w-4xl px-4 pt-20 pb-8">
    <ProjectBackLink />

    <div class="animate-fade-in-up mb-12 opacity-0">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://yamatomo.co.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-block"
        >
          <h1
            class="text-3xl font-bold tracking-tight decoration-2 underline-offset-4 group-hover:underline md:text-4xl"
          >
            Yamatomo
          </h1>
        </a>
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-800">
          {t.badge}
        </span>
      </div>
      <p class="mt-2 text-gray-500">{t.period}</p>
    </div>

    <div class="animate-fade-in-up animation-delay-100 mb-12 overflow-x-clip opacity-0">
      <MacbookFrame
        src="https://yamatomo.co.jp/"
        url="yamatomo.co.jp"
        title={t.frameTitle}
        class="mx-auto max-w-2xl"
      />
      <p class="mt-4 text-center font-mono text-xs text-gray-400">$ open https://yamatomo.co.jp</p>
    </div>

    <section
      class="animate-fade-in-up animation-delay-100 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.overview}</h2>
      <p class="leading-relaxed text-gray-600" set:html={t.overviewHtml} />
    </section>

    <section
      class="animate-fade-in-up animation-delay-200 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.techStack}</h2>
      <div class="space-y-4">
        {
          stackGroups.map((group) => (
            <div>
              <p class="mb-2 text-xs font-semibold text-gray-500">{group.label}</p>
              <div class="flex flex-wrap gap-2">
                {group.items.map(({ name, cls }) => {
                  const icon = getTechIcon(name);
                  return (
                    <span
                      class={`inline-flex items-center gap-1.5 px-3 py-1.5 ${cls} rounded-full text-sm`}
                    >
                      {icon && (
                        <img src={icon} class="h-4 w-4 flex-shrink-0" alt="" loading="lazy" />
                      )}
                      {name}
                    </span>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-300 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{t.features.heading}</h2>
      <div class="grid grid-cols-1 gap-4 text-sm text-gray-600 md:grid-cols-2">
        {
          t.features.items.map((feature) => (
            <div class="rounded-2xl bg-gray-50 p-5">
              <h3 class="mb-2 font-bold text-gray-900">{feature.title}</h3>
              <p>{feature.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-400 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{t.role.heading}</h2>
      <p class="text-sm leading-relaxed text-gray-600">{t.role.body}</p>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 rounded-3xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 text-white opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.links}</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://yamatomo.co.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-emerald-600 px-4 py-2 font-medium transition-colors hover:bg-emerald-700"
        >
          {t.officialSite}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
