---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import MacbookFrame from '../../../components/MacbookFrame.astro';
import { getTechIcon } from '../../../lib/techIcons';
import common from '../../../i18n/dict/common';
import yamatomoDict from '../../../i18n/dict/yamatomo';

const locale = localeFromParam(Astro.params.lang);
const c = common[locale];
const t = yamatomoDict[locale];

const iosStack = [
  { name: 'SwiftUI', cls: 'bg-orange-50 text-orange-700' },
  { name: 'Firebase', cls: 'bg-amber-50 text-amber-700' },
  { name: 'OpenAI API', cls: 'bg-gray-100 text-gray-700' },
];
const webStack = [
  { name: 'React', cls: 'bg-sky-50 text-sky-700' },
  { name: 'TypeScript', cls: 'bg-blue-50 text-blue-700' },
  { name: 'Firebase', cls: 'bg-amber-50 text-amber-700' },
  { name: 'Tailwind CSS', cls: 'bg-cyan-50 text-cyan-700' },
  { name: 'Vite', cls: 'bg-purple-50 text-purple-700' },
];

const stackGroups = [
  { label: t.stack.ios, items: iosStack },
  { label: t.stack.web, items: webStack },
];
---

<BaseLayout title={t.title} description={t.description} path="/projects/yamatomo">
  <main class="pt-20 pb-8 px-4 max-w-4xl mx-auto">
    <ProjectBackLink />

    <div class="mb-12 opacity-0 animate-fade-in-up">
      <div class="flex items-center gap-3 flex-wrap">
        <a
          href="https://yamatomo.co.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block group"
        >
          <h1 class="text-3xl md:text-4xl font-bold tracking-tight group-hover:underline underline-offset-4 decoration-2">
            Yamatomo
          </h1>
        </a>
        <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-medium">
          {t.badge}
        </span>
      </div>
      <p class="text-gray-500 mt-2">{t.period}</p>
    </div>

    <div class="mb-12 overflow-x-clip opacity-0 animate-fade-in-up animation-delay-100">
      <MacbookFrame
        src="https://yamatomo.co.jp/"
        url="yamatomo.co.jp"
        title={t.frameTitle}
        class="max-w-2xl mx-auto"
      />
      <p class="mt-4 text-center text-xs text-gray-400 font-mono">
        $ open https://yamatomo.co.jp
      </p>
    </div>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-100">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.overview}</h2>
      <p class="text-gray-600 leading-relaxed" set:html={t.overviewHtml} />
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-200">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.techStack}</h2>
      <div class="space-y-4">
        {stackGroups.map((group) => (
          <div>
            <p class="text-xs font-semibold text-gray-500 mb-2">{group.label}</p>
            <div class="flex flex-wrap gap-2">
              {group.items.map(({ name, cls }) => {
                const icon = getTechIcon(name);
                return (
                  <span
                    class={`inline-flex items-center gap-1.5 px-3 py-1.5 ${cls} rounded-full text-sm`}
                  >
                    {icon && (
                      <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
                    )}
                    {name}
                  </span>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-300">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.features.heading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-600 text-sm">
        {t.features.items.map((feature) => (
          <div class="bg-gray-50 rounded-2xl p-5">
            <h3 class="font-bold text-gray-900 mb-2">{feature.title}</h3>
            <p>{feature.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-400">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.role.heading}</h2>
      <p class="text-gray-600 text-sm leading-relaxed">{t.role.body}</p>
    </section>

    <section class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-8 text-white opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.links}</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://yamatomo.co.jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 rounded-full hover:bg-emerald-700 transition-colors font-medium"
        >
          {t.officialSite}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
