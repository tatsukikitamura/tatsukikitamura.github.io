---
import { localePaths, localeFromParam, localizePath } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { GitHubIcon } from '../../../components/Icons';
import { getTechIcon } from '../../../lib/techIcons';
import projectsDict from '../../../i18n/dict/projects';

const locale = localeFromParam(Astro.params.lang);
const t = projectsDict[locale];
const l = (p: string) => localizePath(p, locale);

const projects = t.projects;
---

<BaseLayout title={t.title} description={t.description} path="/projects">
  <div class="px-6 pt-24 pb-16">
    <div class="mx-auto max-w-3xl">
      <PageHeader command="ls -la projects/" subtitle={t.subtitle}>{t.heading}</PageHeader>

      <div class="grid grid-cols-1 gap-5">
        {
          projects.map((project, index) => (
            <a
              href={l(project.link)}
              class="animate-fade-in rounded-xl border border-gray-200 bg-white p-6 transition-all hover:border-gray-300 hover:bg-gray-50/50"
              style={`animation-delay:${(index + 1) * 100}ms`}
            >
              <div class="mb-1.5 font-mono text-[10px] text-gray-400">
                [{String(index + 1).padStart(2, '0')}]
              </div>
              <h3 class="font-semibold text-gray-900">{project.title}</h3>
              <p class="mt-1 font-mono text-xs text-gray-500">{project.period}</p>
              <p class="mt-3 text-sm leading-relaxed text-gray-600">{project.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => {
                  const icon = getTechIcon(tag);
                  return (
                    <span class="inline-flex items-center gap-1.5 rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
                      {icon && (
                        <img src={icon} class="h-3.5 w-3.5 flex-shrink-0" alt="" loading="lazy" />
                      )}
                      {tag}
                    </span>
                  );
                })}
              </div>
            </a>
          ))
        }
      </div>

      <div class="animate-fade-in animation-delay-500 mt-10 text-center">
        <a
          href="https://github.com/tatsukikitamura"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-5 py-2.5 text-sm text-white transition-colors hover:bg-gray-800"
        >
          <GitHubIcon />
          {t.viewAllOnGitHub}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
