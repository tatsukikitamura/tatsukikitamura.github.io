---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import { GitHubIcon } from '../../../components/Icons';
import { getTechIcon } from '../../../lib/techIcons';
import commonDict from '../../../i18n/dict/common';
import mbtiDict from '../../../i18n/dict/mbti';

const locale = localeFromParam(Astro.params.lang);
const c = commonDict[locale];
const t = mbtiDict[locale];

const TECHS = [
  { name: 'Ruby on Rails', cls: 'bg-red-50 text-red-700' },
  { name: 'OpenAI API', cls: 'bg-gray-100 text-gray-700' },
  { name: 'Redis', cls: 'bg-red-50 text-red-700' },
  { name: 'Heroku', cls: 'bg-purple-50 text-purple-700' },
];
---

<BaseLayout
  title={t.title}
  description={t.description}
  path="/projects/mbti-app"
>
  <main class="pt-20 pb-8 px-4 max-w-4xl mx-auto">
    <ProjectBackLink />

    <div class="mb-12 opacity-0 animate-fade-in-up">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight">
          {t.heading}
        </h1>
        <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs font-medium">
          {c.closed}
        </span>
      </div>
      <p class="text-gray-500 mt-2">{t.period}</p>
    </div>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-100">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.overview}</h2>
      <p class="text-gray-600 leading-relaxed">
        {t.overview}
      </p>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-200">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.techStack}</h2>
      <div class="flex flex-wrap gap-2">
        {TECHS.map(({ name, cls }) => {
          const icon = getTechIcon(name);
          return (
            <span
              class={`inline-flex items-center gap-1.5 px-3 py-1.5 ${cls} rounded-full text-sm`}
            >
              {icon && (
                <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
              )}
              {name}
            </span>
          );
        })}
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-300">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.problem.heading}</h2>
      <div class="space-y-4 text-gray-600">
        <p>{t.problem.intro}</p>
        <ul class="space-y-2 ml-4">
          {t.problem.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-400">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.features.heading}</h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">{t.features.story.heading}</h3>
          <ul class="space-y-2 text-gray-600 text-sm">
            {t.features.story.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">{t.features.result.heading}</h3>
          <p class="text-gray-600 text-sm">
            {t.features.result.body}
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-800 mb-2">{t.features.technical.heading}</h3>
          <ul class="space-y-2 text-gray-600 text-sm">
            {t.features.technical.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
      <section class="bg-white rounded-3xl border border-gray-200 p-8 opacity-0 animate-fade-in-up animation-delay-500">
        <h2 class="text-xl font-bold tracking-tight mb-4">{c.outcomes}</h2>
        <p class="text-gray-600 text-sm">
          {t.outcome}
        </p>
      </section>

      <section class="bg-white rounded-3xl border border-gray-200 p-8 opacity-0 animate-fade-in-up animation-delay-500">
        <h2 class="text-xl font-bold tracking-tight mb-4">{c.learnings}</h2>
        <p class="text-gray-600 text-sm">
          {t.learning}
        </p>
      </section>
    </div>

    <section class="bg-gradient-to-b from-gray-900 to-gray-800 rounded-3xl p-8 text-white opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.links}</h2>
      <div class="flex flex-wrap gap-4 items-center">
        <a
          href="https://github.com/tatsukikitamura"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full hover:bg-white/20 transition-colors"
        >
          <GitHubIcon />
          GitHub
        </a>
        <span class="text-sm text-white/60">{c.demoClosed}</span>
      </div>
    </section>
  </main>
</BaseLayout>
