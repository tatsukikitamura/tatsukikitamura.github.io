---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import { getTechIcon } from '../../../lib/techIcons';
import common from '../../../i18n/dict/common';
import atcoderDict from '../../../i18n/dict/atcoder';

const locale = localeFromParam(Astro.params.lang);
const c = common[locale];
const t = atcoderDict[locale];

const LANGS = ['Python', 'C++'];

// Colour scheme per stat card, in the same order as t.stats.
const STAT_STYLES = [
  { card: 'bg-amber-50 border-amber-200', headingCls: 'text-amber-800', valueCls: 'text-amber-600' },
  { card: 'bg-blue-50 border-blue-200', headingCls: 'text-blue-800', valueCls: 'text-blue-600' },
  { card: 'bg-yellow-50 border-yellow-200', headingCls: 'text-yellow-800', valueCls: 'text-yellow-600' },
];
const stats = t.stats.map((stat, i) => ({ ...stat, ...STAT_STYLES[i]! }));
---

<BaseLayout title={t.title} description={t.description} path="/projects/atcoder">
  <main class="pt-20 pb-8 px-4 max-w-4xl mx-auto">
    <ProjectBackLink />

    <div class="mb-12 opacity-0 animate-fade-in-up">
      <a
        href="https://atcoder.jp/users/oreccchi"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block group"
      >
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight group-hover:underline underline-offset-4 decoration-2">
          AtCoder
        </h1>
      </a>
      <p class="text-gray-500 mt-2">{t.period}</p>
    </div>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-100">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.overview}</h2>
      <p class="text-gray-600 leading-relaxed">{t.overviewBody}</p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      {stats.map((stat) => (
        <div class={`${stat.card} rounded-xl border p-6 opacity-0 animate-fade-in-up animation-delay-200`}>
          <h3 class={`font-semibold ${stat.headingCls}`}>{stat.heading}</h3>
          <p class={`${stat.valueCls} mt-1 text-sm`}>{stat.value}</p>
        </div>
      ))}
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-300">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.languages}</h2>
      <div class="flex flex-wrap gap-2">
        {LANGS.map((name) => {
          const icon = getTechIcon(name);
          return (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 rounded-full text-sm">
              {icon && (
                <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
              )}
              {name}
            </span>
          );
        })}
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-400">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.approach.heading}</h2>
      <div class="space-y-4 text-gray-600 text-sm">
        <ul class="space-y-2">
          {t.approach.items.map((item) => <li>• {item}</li>)}
        </ul>
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.efforts.heading}</h2>
      <div class="space-y-4 text-gray-600 text-sm">
        <ul class="space-y-3">
          {t.efforts.items.map((item) => (
            <li class="flex items-start gap-2">
              <span class="text-gray-300 mt-0.5">—</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.learnings}</h2>
      <div class="space-y-3 text-gray-600 text-sm">
        {t.learnings.map((item) => <p>• {item}</p>)}
      </div>
    </section>

    <section class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-8 text-white opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.links}</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://atcoder.jp/users/oreccchi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full hover:bg-white/20 transition-colors"
        >
          <span class="font-bold">A</span>
          {t.profileLabel}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
