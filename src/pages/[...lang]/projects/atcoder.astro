---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import { getTechIcon } from '../../../lib/techIcons';
import common from '../../../i18n/dict/common';
import atcoderDict from '../../../i18n/dict/atcoder';

const locale = localeFromParam(Astro.params.lang);
const c = common[locale];
const t = atcoderDict[locale];

const LANGS = ['Python', 'C++'];

// Colour scheme per stat card, in the same order as t.stats.
const STAT_STYLES = [
  {
    card: 'bg-amber-50 border-amber-200',
    headingCls: 'text-amber-800',
    valueCls: 'text-amber-600',
  },
  { card: 'bg-blue-50 border-blue-200', headingCls: 'text-blue-800', valueCls: 'text-blue-600' },
  {
    card: 'bg-yellow-50 border-yellow-200',
    headingCls: 'text-yellow-800',
    valueCls: 'text-yellow-600',
  },
];
const stats = t.stats.map((stat, i) => ({ ...stat, ...STAT_STYLES[i]! }));
---

<BaseLayout title={t.title} description={t.description} path="/projects/atcoder">
  <main class="mx-auto max-w-4xl px-4 pt-20 pb-8">
    <ProjectBackLink />

    <div class="animate-fade-in-up mb-12 opacity-0">
      <a
        href="https://atcoder.jp/users/oreccchi"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-block"
      >
        <h1
          class="text-3xl font-bold tracking-tight decoration-2 underline-offset-4 group-hover:underline md:text-4xl"
        >
          AtCoder
        </h1>
      </a>
      <p class="mt-2 text-gray-500">{t.period}</p>
    </div>

    <section
      class="animate-fade-in-up animation-delay-100 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.overview}</h2>
      <p class="leading-relaxed text-gray-600">{t.overviewBody}</p>
    </section>

    <section class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        stats.map((stat) => (
          <div
            class={`${stat.card} animate-fade-in-up animation-delay-200 rounded-xl border p-6 opacity-0`}
          >
            <h3 class={`font-semibold ${stat.headingCls}`}>{stat.heading}</h3>
            <p class={`${stat.valueCls} mt-1 text-sm`}>{stat.value}</p>
          </div>
        ))
      }
    </section>

    <section
      class="animate-fade-in-up animation-delay-300 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{t.languages}</h2>
      <div class="flex flex-wrap gap-2">
        {
          LANGS.map((name) => {
            const icon = getTechIcon(name);
            return (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1.5 text-sm text-blue-700">
                {icon && <img src={icon} class="h-4 w-4 flex-shrink-0" alt="" loading="lazy" />}
                {name}
              </span>
            );
          })
        }
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-400 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{t.approach.heading}</h2>
      <div class="space-y-4 text-sm text-gray-600">
        <ul class="space-y-2">
          {t.approach.items.map((item) => <li>• {item}</li>)}
        </ul>
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{t.efforts.heading}</h2>
      <div class="space-y-4 text-sm text-gray-600">
        <ul class="space-y-3">
          {
            t.efforts.items.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-gray-300">—</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.learnings}</h2>
      <div class="space-y-3 text-sm text-gray-600">
        {t.learnings.map((item) => <p>• {item}</p>)}
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 rounded-3xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 text-white opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.links}</h2>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://atcoder.jp/users/oreccchi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 transition-colors hover:bg-white/20"
        >
          <span class="font-bold">A</span>
          {t.profileLabel}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
