---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import { getTechIcon } from '../../../lib/techIcons';
import commonDict from '../../../i18n/dict/common';
import opendataDict from '../../../i18n/dict/opendata';

const locale = localeFromParam(Astro.params.lang);
const c = commonDict[locale];
const t = opendataDict[locale];

const TECHS = [
  { name: 'Python 3.12', cls: 'bg-blue-50 text-blue-700' },
  { name: 'FastAPI', cls: 'bg-teal-50 text-teal-700' },
  { name: 'PostgreSQL', cls: 'bg-indigo-50 text-indigo-700' },
  { name: 'OpenAI API', cls: 'bg-gray-100 text-gray-700' },
  { name: 'Vite + JS', cls: 'bg-purple-50 text-purple-700' },
  { name: 'Tailwind CSS', cls: 'bg-cyan-50 text-cyan-700' },
  { name: 'GitHub Actions', cls: 'bg-gray-100 text-gray-700' },
];
---

<BaseLayout
  title={t.title}
  description={t.description}
  path="/projects/opendata"
>
  <main class="pt-20 pb-8 px-4 max-w-4xl mx-auto">
    <ProjectBackLink />

    <div class="mb-12 opacity-0 animate-fade-in-up">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{t.heading}</h1>
        <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-xs font-medium">
          {t.badge}
        </span>
        <span class="px-3 py-1 bg-gray-100 text-gray-600 rounded-full text-xs font-medium">
          {c.closed}
        </span>
      </div>
      <p class="text-gray-500 mt-2">{t.period}</p>
    </div>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-100">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.overview}</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        {t.overview.hook}
      </p>
      <p class="text-gray-600 leading-relaxed" set:html={t.overview.body} />
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-200">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.techStack}</h2>
      <div class="flex flex-wrap gap-2">
        {TECHS.map(({ name, cls }) => {
          const icon = getTechIcon(name);
          return (
            <span
              class={`inline-flex items-center gap-1.5 px-3 py-1.5 ${cls} rounded-full text-sm`}
            >
              {icon && (
                <img src={icon} class="w-4 h-4 flex-shrink-0" alt="" loading="lazy" />
              )}
              {name}
            </span>
          );
        })}
      </div>
    </section>

    <section class="bg-white rounded-3xl border border-gray-200 p-8 mb-6 opacity-0 animate-fade-in-up animation-delay-300">
      <h2 class="text-xl font-bold tracking-tight mb-4">{t.features.heading}</h2>
      <div class="space-y-6 text-gray-600">
        {t.features.cards.map((card) => (
          <div class="bg-gray-50 rounded-2xl p-6">
            <h3 class="font-bold text-gray-900 mb-3">
              {card.title}
            </h3>
            <p class={card.items.length > 0 ? 'text-sm mb-3' : 'text-sm'} set:html={card.body} />
            {card.items.length > 0 && (
              <ul class="list-disc list-inside text-sm space-y-1 ml-2">
                {card.items.map((item) => <li set:html={item} />)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="bg-gradient-to-br from-gray-900 to-gray-800 rounded-3xl p-8 text-white opacity-0 animate-fade-in-up animation-delay-500">
      <h2 class="text-xl font-bold tracking-tight mb-4">{c.links}</h2>
      <div class="flex flex-wrap gap-4 items-center">
        <a
          href="https://challenge2025.odpt.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 rounded-full hover:bg-white/20 transition-colors"
        >
          {t.contest}
        </a>
        <span class="text-sm text-white/60">{c.demoClosed}</span>
      </div>
    </section>
  </main>
</BaseLayout>
