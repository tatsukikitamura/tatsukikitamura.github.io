---
import { localePaths, localeFromParam } from '../../../i18n';
export function getStaticPaths() {
  return localePaths();
}
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectBackLink from '../../../components/ProjectBackLink.astro';
import { getTechIcon } from '../../../lib/techIcons';
import commonDict from '../../../i18n/dict/common';
import opendataDict from '../../../i18n/dict/opendata';

const locale = localeFromParam(Astro.params.lang);
const c = commonDict[locale];
const t = opendataDict[locale];

const TECHS = [
  { name: 'Python 3.12', cls: 'bg-blue-50 text-blue-700' },
  { name: 'FastAPI', cls: 'bg-teal-50 text-teal-700' },
  { name: 'PostgreSQL', cls: 'bg-indigo-50 text-indigo-700' },
  { name: 'OpenAI API', cls: 'bg-gray-100 text-gray-700' },
  { name: 'Vite + JS', cls: 'bg-purple-50 text-purple-700' },
  { name: 'Tailwind CSS', cls: 'bg-cyan-50 text-cyan-700' },
  { name: 'GitHub Actions', cls: 'bg-gray-100 text-gray-700' },
];
---

<BaseLayout title={t.title} description={t.description} path="/projects/opendata">
  <main class="mx-auto max-w-4xl px-4 pt-20 pb-8">
    <ProjectBackLink />

    <div class="animate-fade-in-up mb-12 opacity-0">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{t.heading}</h1>
        <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-800">
          {t.badge}
        </span>
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">
          {c.closed}
        </span>
      </div>
      <p class="mt-2 text-gray-500">{t.period}</p>
    </div>

    <section
      class="animate-fade-in-up animation-delay-100 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.overview}</h2>
      <p class="mb-4 leading-relaxed text-gray-600">
        {t.overview.hook}
      </p>
      <p class="leading-relaxed text-gray-600" set:html={t.overview.body} />
    </section>

    <section
      class="animate-fade-in-up animation-delay-200 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.techStack}</h2>
      <div class="flex flex-wrap gap-2">
        {
          TECHS.map(({ name, cls }) => {
            const icon = getTechIcon(name);
            return (
              <span
                class={`inline-flex items-center gap-1.5 px-3 py-1.5 ${cls} rounded-full text-sm`}
              >
                {icon && <img src={icon} class="h-4 w-4 flex-shrink-0" alt="" loading="lazy" />}
                {name}
              </span>
            );
          })
        }
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-300 mb-6 rounded-3xl border border-gray-200 bg-white p-8 opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{t.features.heading}</h2>
      <div class="space-y-6 text-gray-600">
        {
          t.features.cards.map((card) => (
            <div class="rounded-2xl bg-gray-50 p-6">
              <h3 class="mb-3 font-bold text-gray-900">{card.title}</h3>
              <p class={card.items.length > 0 ? 'mb-3 text-sm' : 'text-sm'} set:html={card.body} />
              {card.items.length > 0 && (
                <ul class="ml-2 list-inside list-disc space-y-1 text-sm">
                  {card.items.map((item) => (
                    <li set:html={item} />
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="animate-fade-in-up animation-delay-500 rounded-3xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 text-white opacity-0"
    >
      <h2 class="mb-4 text-xl font-bold tracking-tight">{c.links}</h2>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://challenge2025.odpt.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 transition-colors hover:bg-white/20"
        >
          {t.contest}
        </a>
        <span class="text-sm text-white/60">{c.demoClosed}</span>
      </div>
    </section>
  </main>
</BaseLayout>
