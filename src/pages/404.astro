---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found" description="お探しのページは見つかりませんでした。" path="/404">
  <section class="px-6 pt-32 pb-16">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="mb-4 text-3xl font-bold text-gray-900">404 - Not Found</h1>
      <p class="mb-8 text-sm text-gray-500">お探しのページは見つかりませんでした。</p>
      <a
        href="/"
        class="inline-block rounded-lg px-5 py-2 text-sm font-medium text-white transition-colors"
        style="background:#0a66c2"
      >
        ホームに戻る
      </a>
    </div>
  </section>
</BaseLayout>
