---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Artwork, ArtworkCategory } from '../types';

// これから制作するアートワークをここに追加していく。
// image は public/images/artworks/ 配下に置く想定。
const artworks: Artwork[] = [
  {
    id: 'bubbles',
    title: '気泡とり',
    category: 'web',
    description: '保護フィルムを貼ったときの気泡をカーソルで押し出して抜く、体験型の実験ページ。',
    date: '2026.08',
    link: '/artworks/bubbles',
  },
];

const categoryLabels: Record<ArtworkCategory, string> = {
  flyer: 'Flyer',
  tshirt: 'T-shirt',
  web: 'Web',
  other: 'Other',
};

// 作品がまだないカテゴリに表示する coming soon 枠。
const allPlaceholders: { category: ArtworkCategory; note: string }[] = [
  { category: 'flyer', note: '一枚もののフライヤー' },
  { category: 'tshirt', note: 'Tシャツのグラフィック' },
  { category: 'web', note: '実験的な Web ページ' },
];
const placeholders = allPlaceholders.filter(
  (slot) => !artworks.some((work) => work.category === slot.category)
);

const DESCRIPTION =
  '北村健紀（Tatsuki Kitamura）のアートワーク集。フライヤー、Tシャツ、Web ページなどのグラフィック制作物をまとめています。';
---

<BaseLayout title="Artworks - 制作アートワーク" description={DESCRIPTION} path="/artworks" frame={false}>
  <div class="relative min-h-screen overflow-hidden bg-[#101010] text-[#dfdfd6]">
    <!-- 背景のアンビエント光 -->
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[420px] w-[720px] max-w-[90vw] -translate-x-1/2 rounded-full bg-white opacity-[0.06] blur-[140px]"
      aria-hidden="true"
    >
    </div>

    <!-- カーソル追従のスポットライト + 残光トレイル (hover デバイスのみ、script 側で有効化) -->
    <canvas id="cursor-spotlight" class="pointer-events-none fixed inset-0 z-10 h-full w-full" aria-hidden="true"></canvas>

    <div class="relative mx-auto max-w-5xl px-6 pt-8 pb-20">
      <!-- root へ戻るリンク -->
      <a
        href="/"
        class="inline-flex items-center gap-2 font-mono text-sm text-[#98989f] transition-colors hover:text-white"
      >
        <span aria-hidden="true">←</span>
        tatsuki.dev
      </a>

      <!-- Hero -->
      <header class="mt-20 mb-16 text-center md:mt-28">
        <h1
          class="animate-fade-in-up text-4xl font-bold tracking-tight text-white sm:text-6xl md:text-7xl"
          style="opacity:0"
        >
          tatsuki.artworks
        </h1>
        <p
          class="animate-fade-in-up animation-delay-200 mx-auto mt-6 max-w-xl text-base leading-relaxed text-[#98989f] md:text-lg"
          style="opacity:0"
        >
          フライヤー、Tシャツ、Web ページ。<br class="hidden md:block" />
          手を動かして作ったグラフィックをここに集めていきます。
        </p>
        <div
          class="animate-fade-in animation-delay-400 mt-8 flex flex-wrap items-center justify-center gap-2"
          style="opacity:0"
        >
          {
            Object.values(categoryLabels).map((label) => (
              <span class="rounded-full border border-white/10 bg-white/[0.04] px-3.5 py-1 font-mono text-xs text-[#98989f]">
                {label}
              </span>
            ))
          }
        </div>
      </header>

      <!-- Works grid -->
      <section class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          artworks.map((work, index) => (
            <a
              href={work.link}
              class="group animate-fade-in overflow-hidden rounded-xl border border-white/10 bg-[#161618] transition-all duration-300 hover:-translate-y-1 hover:border-white/30 hover:shadow-[0_8px_40px_-12px_rgba(255,255,255,0.15)]"
              style={`opacity:0;animation-delay:${(index + 1) * 100}ms`}
            >
              {work.image && (
                <div class="aspect-[4/3] overflow-hidden border-b border-white/5">
                  <img
                    src={work.image}
                    alt={work.title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-5">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[10px] tracking-wider text-white/70 uppercase">
                    {categoryLabels[work.category]}
                  </span>
                  <span class="font-mono text-[10px] text-[#98989f]">{work.date}</span>
                </div>
                <h2 class="mt-2 font-semibold text-white">
                  {work.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-[#98989f]">{work.description}</p>
              </div>
            </a>
          ))
        }

        {
          placeholders.map((slot, index) => (
              <div
                class="animate-fade-in flex aspect-[4/3] flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-white/15 bg-white/[0.02] transition-colors duration-300 hover:border-white/30 hover:bg-white/[0.04]"
                style={`opacity:0;animation-delay:${500 + index * 100}ms`}
              >
                <span class="font-mono text-xs tracking-wider text-white/80 uppercase">
                  {categoryLabels[slot.category]}
                </span>
                <p class="text-sm text-[#98989f]">{slot.note}</p>
                <span class="rounded-full border border-white/10 px-3 py-1 font-mono text-[10px] text-[#98989f]">
                  coming soon
                </span>
              </div>
            ))
        }
      </section>

      <footer
        class="animate-fade-in animation-delay-800 mt-20 text-center font-mono text-xs text-[#98989f]/60"
        style="opacity:0"
      >
        crafted by Tatsuki Kitamura
      </footer>
    </div>
  </div>

  <script>
    // カーソルに少し遅れて光が追いつく懐中電灯風スポットライト。
    // 毎フレーム canvas 全体を少しずつ透明に戻しながら現在位置に光を描くことで、
    // 動かした軌跡が微かな残光になってすっと消える。
    // タッチ端末では動かないので、hover デバイスでのみ有効化する。
    const canvas = document.getElementById('cursor-spotlight') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (canvas && ctx && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const resize = () => {
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize);

      let targetX = 0;
      let targetY = 0;
      let x = 0;
      let y = 0;
      let visible = false;

      window.addEventListener('mousemove', (event) => {
        targetX = event.clientX;
        targetY = event.clientY;
        if (!visible) {
          visible = true;
          x = targetX;
          y = targetY;
        }
      });

      document.documentElement.addEventListener('mouseleave', () => {
        visible = false;
      });

      const CORE_RADIUS = 48;
      const draw = () => {
        // 前フレームまでの光を少しずつ消す → 残光がフェードアウトする
        ctx.globalCompositeOperation = 'destination-out';
        ctx.fillStyle = 'rgba(0, 0, 0, 0.08)';
        ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

        if (visible) {
          x += (targetX - x) * 0.14;
          y += (targetY - y) * 0.14;

          ctx.globalCompositeOperation = 'lighter';
          // 一等星のように、中心は真っ白でほぼ広がらない鋭い光にする
          const glow = ctx.createRadialGradient(x, y, 0, x, y, CORE_RADIUS);
          glow.addColorStop(0, 'rgba(255, 255, 255, 1)');
          glow.addColorStop(0.1, 'rgba(255, 255, 255, 0.6)');
          glow.addColorStop(0.3, 'rgba(255, 255, 255, 0.08)');
          glow.addColorStop(1, 'rgba(255, 255, 255, 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(x, y, CORE_RADIUS, 0, Math.PI * 2);
          ctx.fill();
        }
        requestAnimationFrame(draw);
      };
      requestAnimationFrame(draw);
    }
  </script>
</BaseLayout>
