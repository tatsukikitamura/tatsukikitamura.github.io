---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  WorkIcon,
  HackathonIcon,
  EventIcon,
  EduIcon,
} from '../components/Icons';

const DESCRIPTION =
  '北村健紀の経歴。Gravity Game Arise でのQA・デバッグ（2年）、PR TIMESハッカソンでのチーム開発など。';
---

<BaseLayout
  title="Experience - 経歴"
  description={DESCRIPTION}
  path="/experience"
>
  <div class="pt-24 pb-16 px-6">
    <div class="max-w-3xl mx-auto">
      <PageHeader command="git log --pretty=experience" subtitle="経歴">
        Experience
      </PageHeader>

      <section class="mb-12">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">
          Work
        </h2>

        <div class="relative">
          <div class="absolute left-5 top-0 bottom-0 w-px bg-gray-200"></div>

          <div class="space-y-6">
            <article class="relative pl-14 animate-fade-in animation-delay-100">
              <div
                class="absolute left-3 top-1 w-4 h-4 rounded-full bg-white border-2 flex items-center justify-center"
                style="border-color:#0a66c2"
              >
                <div class="w-1.5 h-1.5 rounded-full" style="background:#0a66c2"></div>
              </div>
              <div class="bg-white border border-gray-200 rounded-xl p-6">
                <div class="flex items-start gap-3 mb-3">
                  <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center text-[#0a66c2]">
                    <WorkIcon />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                      <h3 class="font-semibold text-gray-900">QA・デバッグ</h3>
                      <span class="text-xs text-gray-400">2023年4月 — 2025年4月（2年間）</span>
                    </div>
                    <p class="text-sm text-gray-500 mt-0.5">Gravity Game Arise</p>
                  </div>
                </div>
                <div class="mt-4">
                  <ul class="space-y-1.5 text-xs text-gray-600 leading-relaxed">
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>5名規模のデバッグチームで、モバイル・Steam 向けタイトルの不具合検出・再現・報告を担当</span>
                    </li>
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>テストケースの作成・実行、バグレポートの整理とステータス管理</span>
                    </li>
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>再現性の低い致命的なバグをログ解析で発生条件まで特定し、リリース前の修正につなげた</span>
                    </li>
                  </ul>
                </div>
                <div class="flex flex-wrap gap-2 mt-4">
                  {['Backlog', 'バグ管理', 'テスト設計'].map((tag) => (
                    <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>

            <article class="relative pl-14 animate-fade-in animation-delay-200">
              <div
                class="absolute left-3 top-1 w-4 h-4 rounded-full bg-white border-2 flex items-center justify-center"
                style="border-color:#0a66c2"
              >
                <div class="w-1.5 h-1.5 rounded-full" style="background:#0a66c2"></div>
              </div>
              <div class="bg-white border border-gray-200 rounded-xl p-6">
                <div class="flex items-start gap-3 mb-3">
                  <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center text-[#0a66c2]">
                    <EventIcon />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                      <h3 class="font-semibold text-gray-900">イベント運営（企画責任者）</h3>
                      <span class="text-xs text-gray-400">2025年3月</span>
                    </div>
                    <p class="text-sm text-gray-500 mt-0.5">岳文会（山岳サークル） / SHIBUYA DAIA</p>
                  </div>
                </div>
                <div class="mt-4">
                  <p class="text-xs text-gray-600 leading-relaxed mb-3">
                    渋谷のライブハウス「SHIBUYA DAIA」で約75名規模の卒業生追い出しイベントを企画・運営。企画から当日運営、会計まで一貫して担当。
                  </p>
                  <ul class="space-y-1.5 text-xs text-gray-600 leading-relaxed">
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>日程調整、会場手配、予算設計、告知と参加者管理、当日の進行</span>
                    </li>
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>運営フローをテンプレート化して引き継ぎ資料を作成。翌年も後輩が同じ会場で開催予定</span>
                    </li>
                  </ul>
                </div>
                <div class="flex flex-wrap gap-2 mt-4">
                  {['企画・運営', '75名規模'].map((tag) => (
                    <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>

            <article class="relative pl-14 animate-fade-in animation-delay-300">
              <div
                class="absolute left-3 top-1 w-4 h-4 rounded-full bg-white border-2 flex items-center justify-center"
                style="border-color:#0a66c2"
              >
                <div class="w-1.5 h-1.5 rounded-full" style="background:#0a66c2"></div>
              </div>
              <div class="bg-white border border-gray-200 rounded-xl p-6">
                <div class="flex items-start gap-3 mb-3">
                  <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center text-[#0a66c2]">
                    <HackathonIcon />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                      <h3 class="font-semibold text-gray-900">PR TIMESハッカソン</h3>
                      <span class="text-xs text-gray-400">2025年8月（3日間）</span>
                    </div>
                    <p class="text-sm text-gray-500 mt-0.5">PR TIMES主催 / 4人チーム</p>
                  </div>
                </div>
                <div class="mt-4">
                  <p class="text-xs text-gray-600 leading-relaxed mb-3">
                    プレスリリースをAIで添削するWebアプリを、4人チーム・3日間で開発。
                  </p>
                  <ul class="space-y-1.5 text-xs text-gray-600 leading-relaxed">
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>バックエンドを担当し、AI APIを呼び出すエンドポイントを実装</span>
                    </li>
                    <li class="flex gap-2">
                      <span class="text-gray-300 mt-0.5">—</span>
                      <span>ブランチ運用・プルリクエストベースのチーム開発フローを整備</span>
                    </li>
                  </ul>
                </div>
                <div class="flex flex-wrap gap-2 mt-4">
                  {['チーム開発', '生成AI', 'Git運用'].map((tag) => (
                    <span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </article>

          </div>
        </div>
      </section>

      <section class="animate-fade-in animation-delay-500">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">
          Education
        </h2>

        <div class="relative">
          <div class="absolute left-5 top-0 bottom-0 w-px bg-gray-200"></div>

          <article class="relative pl-14">
            <div
              class="absolute left-3 top-1 w-4 h-4 rounded-full bg-white border-2 flex items-center justify-center"
              style="border-color:#0a66c2"
            >
              <div class="w-1.5 h-1.5 rounded-full" style="background:#0a66c2"></div>
            </div>
            <div class="bg-white border border-gray-200 rounded-xl p-6">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center text-[#0a66c2]">
                  <EduIcon className="w-5 h-5" />
                </div>
                <div>
                  <h3 class="font-semibold text-gray-900">早稲田大学</h3>
                  <p class="text-sm text-gray-500 mt-0.5">教育学部 数学科</p>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
